{
  "expo": {
    "name": "HPMS Mobile",
    "slug": "hpms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f1b3d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hpms.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1b3d"
      },
      "package": "com.hpms.mobile",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "hpms-mobile"
      }
    }
  }
}
